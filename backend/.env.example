# ==========================================================================
# Gym CRM backend environment configuration (TEMPLATE)
# Copy this file to .env and fill in real values. NEVER commit the real .env.
#
# SECURITY: before going to production, ROTATE any secrets that were ever
# checked into the repo or shared (JWT secret, DB password, SMTP keys,
# Razorpay keys). Generate a fresh JWT secret with:
#     node scripts/dev/generateSecret.js
# ==========================================================================

# --- Database ---
# Local PostgreSQL from the root docker-compose.yml
DATABASE_URL=postgresql://gymcrm:gymcrm_local@localhost:5433/gymcrm

# --- Server & Environment ---
PORT=5000
# Set to "production" for launch. In production CORS only allows CORS_ORIGINS
# and mock Razorpay is disabled.
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Comma-separated list of allowed browser origins in production, e.g.
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# --- Authentication ---
# REQUIRED. Generate with:  node scripts/dev/generateSecret.js
# The server refuses to boot if this is missing or set to a placeholder.
JWT_SECRET=
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Email Notifications (SMTP) ---
# Use your provider's SMTP settings. Gmail requires an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_NAME="Gym CRM"
FROM_EMAIL=

# --- WhatsApp Notifications (optional) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
